#!/bin/sh
# svlogd (plain runit) is not present on Venus OS -- confirmed on-device,
# "exec: svlogd: not found", service log/run crash-looped and
# /var/log/OutEquipAc was never created as a result. Every other Venus OS
# service (e.g. vesmart-server, dbus-ble-sensors) uses BusyBox's multilog
# instead; match that convention.
exec multilog t s25000 n4 /var/log/OutEquipAc
